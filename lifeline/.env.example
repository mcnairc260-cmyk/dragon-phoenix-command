# Lifeline environment variables. Copy to .env.local. NEVER commit real values.
# With no variables at all, `npm run dev` runs a full local demo (embedded database, simulated messages).

# --- Mode -------------------------------------------------------------------
# Demo mode is ON unless this is exactly "0". In demo mode no real message is ever sent,
# and the Demo controls (time travel, simulated inbox) are available.
LIFELINE_DEMO_MODE=1

# --- Core (required when demo mode is off) ----------------------------------
# Public origin of the app. Also sets the passkey (WebAuthn) relying-party ID. No trailing slash.
APP_URL=http://localhost:3000
# 32+ random characters. Keys the audit-log chain and the sealed-policy HMAC.
# Losing or changing it makes existing audit chains and sealed policies fail verification.
# Generate: openssl rand -base64 48
LIFELINE_SECRET=
# PostgreSQL connection string (for example Supabase "Session pooler" URL). Unset = embedded database in ./.data
DATABASE_URL=
# Shared secret for the scheduler endpoint: GET/POST /api/cron/tick with "Authorization: Bearer <value>"
CRON_SECRET=
# Wait before a VaultLock release can be completed. Default 259200 (72 hours).
RECOVERY_DELAY_SECONDS=259200

# --- Email (Resend). Live only if demo mode is off AND LIFELINE_LIVE_EMAIL=1 --
RESEND_API_KEY=
EMAIL_FROM="Lifeline <alerts@your-domain.example>"
LIFELINE_LIVE_EMAIL=0

# --- SMS and voice (Twilio). Live only if demo mode is off AND the flag is 1 --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
LIFELINE_LIVE_SMS=0
LIFELINE_LIVE_VOICE=0

# --- Billing (Stripe TEST mode) ----------------------------------------------
# Must start with sk_test_. A live key is refused unless LIFELINE_ALLOW_LIVE_BILLING=1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
LIFELINE_ALLOW_LIVE_BILLING=0
# Displayed prices in cents (provisional).
LIFELINE_PRICE_BASIC_CENTS=499
LIFELINE_PRICE_PREMIUM_CENTS=999

# --- Optional ------------------------------------------------------------------
# Cookieless analytics (Plausible). Unset = no analytics script at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Set to 1 to stop the in-process 15-second scheduler (use when an external scheduler calls /api/cron/tick).
LIFELINE_DISABLE_LOCAL_SCHEDULER=0
# Tests only: run the Vitest suite against a real PostgreSQL server instead of the embedded one.
TEST_DATABASE_URL=
