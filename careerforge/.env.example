# ---------------------------------------------------------------------------
# CareerForge environment. Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/careerforge?schema=public"

# Auth.js session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin. Required in production so Auth.js builds correct callback URLs.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "mock"      — deterministic local provider. No network, no key, no cost.
#               The whole app works end to end on this setting.
# "anthropic" — real Claude API calls. Requires ANTHROPIC_API_KEY.
AI_PROVIDER="mock"

# Only read server-side, only when AI_PROVIDER="anthropic".
ANTHROPIC_API_KEY=""

# Model id used when AI_PROVIDER="anthropic".
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Rate limiting for AI endpoints (per user, in-memory sliding window)
# ---------------------------------------------------------------------------
AI_RATE_LIMIT_MAX="20"
AI_RATE_LIMIT_WINDOW_MS="3600000"

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# When "true", the sign-in page offers a one-click demo login using the seeded
# fictional account. Turn this off in any deployment holding real user data.
NEXT_PUBLIC_DEMO_MODE="true"
DEMO_EMAIL="demo@careerforge.app"
DEMO_PASSWORD="demo-password-1234"
