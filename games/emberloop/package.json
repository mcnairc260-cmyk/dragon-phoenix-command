{
  "name": "emberloop",
  "private": true,
  "version": "1.0.0",
  "description": "EMBERLOOP — a mobile-first portrait survival game (Dragon Phoenix Ascension ecosystem)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
