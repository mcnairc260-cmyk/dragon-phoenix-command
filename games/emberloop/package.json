{
  "name": "emberloop",
  "private": true,
  "version": "1.0.0",
  "description": "EMBERLOOP — a mobile-first portrait survival game (Dragon Phoenix Ascension ecosystem)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
